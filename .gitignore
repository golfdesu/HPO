# 1. Ignore all by default
*

# 2. Explicitly track active benchmark models
!00_hpo_tfm_custom_pytorch.py
!01_hpo_tfm_pytorch.py
!06_hpo_ptst_pytorch.py
!07_hpo_itfm_pytorch.py
!10_hpo_gru_pytorch.py
!13_hpo_smamba_pytorch.py
!17_hpo_xgboost.py
!24_hpo_nhits_pytorch.py
!27_hpo_moderntcn_pytorch.py
!28_hpo_crossformer_pytorch.py

# Track archived inactive models
!archive/inactive_baselines/
!archive/inactive_baselines/**

# 3. Explicitly track root-only metadata, run scripts, configs
!.gitignore
!.gitattributes
!requirements.txt
!README.md
!AGENTS.md
!CLAUDE.md
!paper_alignment_state.json
!run_hpo_all_h100.sbatch
!run_hpo_18_lightgbm_mixed.sbatch
!run_hpo_all_mixed.sbatch
!run_hpo_remaining_h100.sbatch
!run_hpo_07_h100.sbatch
!run_hpo_06_to_28_mixed.sbatch
!run_hpo_elite_mixed.sbatch
!run_hpo_00_07_caltech_h100.sbatch
!run_hpo_elite_8_caltech_h100.sbatch
!run_hpo_elite_4a_jpl_h100.sbatch
!run_hpo_elite_4b_jpl_mixed.sbatch

# 4. Exclude temp, cache, logs, and subdirectories
*fix*
*fix.*
*.log
__pycache__/
*.pyc
.claude/
.agents/
.wikiskill/
archive/
!archive/inactive_baselines/
!archive/inactive_baselines/**
best_params/
configs/
docs/
skills/
